# Terra Edge — Environment Configuration Template
# Copy this file to '.env' and fill in your actual private credentials.
# Do NOT commit '.env' to git version control.

# Google Maps API Key (Optional: for later mapping enhancements)
GOOGLE_MAPS_API_KEY=

# Backend configuration overrides (Optional)
FLOOD_API_PORT=8000
WILDFIRE_API_PORT=8001
LANDSLIDE_API_PORT=8002
AIR_POLLUTION_API_PORT=8003
EXTREME_HEAT_API_PORT=8004
TOXIC_PLUME_API_PORT=8005
AQUATIC_HEALTH_API_PORT=8006
CHATBOT_API_PORT=8007

# AI Provider Keys
# Existing NVIDIA API Key
NV_API_KEY=
# New OpenRouter API Key
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (Postgres backend for alerts, predictions and the node inventory)
# ---------------------------------------------------------------------------
# Where to find these: Supabase dashboard -> your project ->
#   Project Settings -> Data API      = the URL
#   Project Settings -> API Keys      = the keys
#
# Leave these blank and every service keeps running on its old in-memory store,
# so nothing breaks before the project is set up.
#
# Run common/supabase_schema.sql once in the Supabase SQL Editor to create the
# alerts / predictions / nodes tables.

SUPABASE_URL=

# Use the SERVICE ROLE key here. It bypasses row level security and is only
# ever read by the FastAPI services. Never put this key in index.html or any
# other file the browser downloads.
SUPABASE_SERVICE_KEY=

# Optional: table name overrides (defaults shown)
# SUPABASE_ALERTS_TABLE=alerts
# SUPABASE_PREDICTIONS_TABLE=predictions
# SUPABASE_NODES_TABLE=nodes

# Optional: set to false to store only alerts and skip the per-inference log
# SUPABASE_LOG_PREDICTIONS=true
