{
  "model_name": "Air Quality Deterioration Predictor",
  "model_type": "RandomForestClassifier",
  "n_features": 12,
  "features": [
    "pm25",
    "pm10",
    "gas_proxy",
    "temperature",
    "relative_humidity",
    "pressure",
    "pm25_lag_15",
    "pm25_lag_30",
    "pm25_delta_30",
    "pm25_slope_30",
    "hour_sin",
    "hour_cos"
  ],
  "classes": {
    "0": "NORMAL",
    "1": "DETERIORATION_RISK"
  },
  "horizon_minutes": 60
}